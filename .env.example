# ══════════════════════════════════════════════════
# DJANGO CORE
# ══════════════════════════════════════════════════

# Required: Secret key for cryptographic signing
#python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=#############################

# Settings module to use
# Options: ai_dungeon_master.config.settings.development
#          ai_dungeon_master.config.settings.staging
#          ai_dungeon_master.config.settings.production
DJANGO_SETTINGS_MODULE=ai_dungeon_master.config.settings.development

# Debug mode (NEVER True in production!)
DJANGO_DEBUG=True

# Allowed hostnames (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ══════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ══════════════════════════════════════════════════

DB_NAME=ai_dungeon_master
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432


# ══════════════════════════════════════════════════
# ANTHROPIC CLAUDE API
# ══════════════════════════════════════════════════

ANTHROPIC_API_KEY=##############################

# ══════════════════════════════════════════════════
# PRODUCTION ONLY
# ══════════════════════════════════════════════════

