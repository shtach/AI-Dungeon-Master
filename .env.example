# Копируй этот файл, назови его .env и подставь свои реальные данные
# ВНИМАНИЕ: файл .env не должен попадать в GitHub!

# ==========================================
# PGADMIN (Local Database Management)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# ==========================================
# DJANGO CORE
# ==========================================
# Сгенерируй новый ключ для своего ПК: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-50-character-random-secret-key-here
DJANGO_SETTINGS_MODULE=ai_dungeon_master.config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DB_NAME=game_db
DB_USER=pgadmin
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# GOOGLE GEMINI API
# ==========================================
# Получи бесплатный ключ тут: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# PRODUCTION ONLY (Для деплоя)
# ==========================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True